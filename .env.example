# ─────────────────────────────────────────────────────────────────────────────
# Conduit configuration. Copy this file to `.env` and fill in YOUR OWN values.
# Never commit `.env`. Never paste these keys into chat.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gateway / transport / hosting ──
# Local stdio mode ignores these. The HTTP entry (Render) uses PORT (injected by
# the host) and gates /mcp with CONDUIT_API_KEY since it runs generated code.
DASHBOARD_PORT=4317
# PORT=10000                      # set by Render automatically; only for local HTTP testing
CONDUIT_API_KEY=                  # bearer token required on /mcp when set (set it in prod!)
CONDUIT_ALLOWED_ORIGIN=*          # tighten to your dashboard origin if you expose it publicly
# CONDUIT_URL=https://conduit-xxxx.onrender.com/mcp   # used by `npm run demo:http`

# ── Obsidian (hero generation target) ──
# Absolute path to a local Obsidian vault (a folder of .md files).
# On a cloud host there is no local vault, so if this is unset the gateway uses
# the bundled sample-vault/ automatically. Set it only for real local files.
OBSIDIAN_VAULT_PATH=

# ── Generation (Anthropic API — writes the missing connector) ──
# Get a key at https://console.anthropic.com  →  Settings → API Keys
ANTHROPIC_API_KEY=
# Model used to generate connectors. Verify the current string for your account.
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# If empty/unset OR the call fails, Conduit falls back to a bundled, pre-written
# Obsidian connector so the demo never hard-fails. Set to "1" to force fallback.
GENERATOR_FORCE_FALLBACK=

# ── Opsera (THE PRIZE — DevSecOps scan/harden) ──
# Hosted MCP, streamable-http. Token: Opsera Dashboard → API Keys → Generate Token.
# ⚠ CONFIRM the exact scan tool name + arg schema at the Opsera table (§3, §7.5).
OPSERA_MCP_URL=https://mcp.opsera.io/mcp
OPSERA_API_TOKEN=
OPSERA_SCAN_TOOL=security-scan
# If unreachable, Conduit runs a local secrets/heuristic scan so the stage always shows.

# ── Tigris (prebuilt federation target — S3-compatible) ──
# Dashboard: https://console.tigris.dev  → access keys (prefixed tid_ / tsec_)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TIGRIS_ENDPOINT_URL=https://t3.storage.dev
TIGRIS_REGION=auto
TIGRIS_BUCKET=

# ── Daytona (STRETCH — sandboxed execution) ──
# Dashboard: https://app.daytona.io  → API key. Leave blank to use local child-process.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_ENABLED=
